{
  "name": "ftc-discord",
  "version": "1.0.0",
  "type": "module",
  "description": "Multipurpose discord bot for FTC.",
  "main": "dist/Bot.js",
  "scripts": {
    "dev": "tsx watch src/Bot.ts",
    "start:prod": "node release/dist/Bot.js",
    "build": "tsup",
    "test": "jest",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write .",
    "deploy:prod": "powershell -ExecutionPolicy Bypass -File deploy.ps1"
  },
  "author": "Scavable",
  "license": "ISC",
  "dependencies": {
    "discord.js": "^14.26.4",
    "dotenv": "^17.4.2",
    "latest": "^0.2.0",
    "prismarine-nbt": "^2.7.0",
    "winston": "^3.18.3",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.5",
    "globals": "^17.6.0",
    "jest": "^30.4.2",
    "prettier": "^3.8.3",
    "ts-jest": "^29.4.9",
    "tsup": "^8.4.0",
    "tsx": "^4.22.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.4"
  }
}
