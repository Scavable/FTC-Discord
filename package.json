{
  "name": "ftc-discord",
  "version": "1.0.0",
  "type": "module",
  "description": "Multipurpose discord bot for FTC.",
  "main": "dist/Bot.js",
  "scripts": {
    "dev": "tsx watch src/Bot.ts",
    "start:prod": "node release/dist/Bot.js",
    "build": "tsup",
    "test": "jest",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write .",
    "deploy:prod": "powershell -ExecutionPolicy Bypass -File deploy.ps1"
  },
  "author": "Scavable",
  "license": "ISC",
  "dependencies": {
    "discord.js": "^14.25.1",
    "dotenv": "^17.2.3",
    "prismarine-nbt": "^2.7.0",
    "winston": "^3.18.3",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.27.0",
    "@types/jest": "^29.5.14",
    "eslint": "^9.27.0",
    "eslint-config-prettier": "^10.1.5",
    "globals": "^16.1.0",
    "jest": "^29.7.0",
    "prettier": "^3.5.3",
    "ts-jest": "^29.3.4",
    "tsup": "^8.4.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.1"
  }
}
